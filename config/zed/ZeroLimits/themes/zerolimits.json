{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "ZeroLimits",
  "author": "noClaps",
  "themes": [
    {
      "name": "ZeroLimits",
      "appearance": "dark",
      "style": {
        // background: #222, active-background: #333, elevated-background: #282828
        // text: #ccc, muted-text: #aaa, extra-muted-text: #666
        // red: #ea3c65
        // light-green: #d5f5d9, green: #64d970
        // light-yellow: #fff5d8, yellow: #fedf7b, dark-yellow: #876c06
        // light-blue: #ccdefc, blue: #3984f2
        // accent: #ff732e

        // Accents
        "accents": ["#ff732e"],

        // Background
        "background": "#222",
        "background.appearance": "opaque",

        // Border
        "border": "#333",
        "border.disabled": "#333",
        "border.focused": "#333",
        "border.selected": "#333",
        "border.transparent": "#222",
        "border.variant": "#333",

        // Conflict
        "conflict": "#fedf7b", // yellow
        "conflict.background": "#876c06", // dark yellow
        "conflict.border": "#fedf7b", // yellow

        // Created
        "created": "#64d970", // green
        "created.background": "#d5f5d9", // light green
        "created.border": "#64d970", // green

        // Debugger
        "debugger.accent": "#ff732e", // accent

        // Deleted
        "deleted": "#ea3c65", // red
        "deleted.background": "#ea3c65", // red
        "deleted.border": "#ea3c65", // red

        // Drop target
        "drop_target.background": "#333",

        // Editor
        "editor.active_line.background": "#282828",
        "editor.active_line_number": "#ccc",
        "editor.active_wrap_guide": "#ccc",
        "editor.background": "#222",
        "editor.debugger_active_line.background": "#333",
        "editor.document_highlight.bracket_background": "#333",
        "editor.document_highlight.read_background": "#333",
        "editor.document_highlight.write_background": "#333",
        "editor.foreground": "#ccc",
        "editor.gutter.background": "#222",
        "editor.highlighted_line.background": "#333",
        "editor.hover_line_number": "#aaa",
        "editor.line_number": "#666",
        "editor.indent_guide": "#666",
        "editor.indent_guide_active": "#aaa",
        "editor.invisible": "#666",
        "editor.subheader.background": "#282828",
        "editor.wrap_guide": "#666",

        // Element
        "element.active": "#333",
        "element.background": "#282828",
        "element.disabled": "#282828",
        "element.hover": "#333",
        "element.selected": "#333",

        // Elevated surface
        "elevated_surface.background": "#282828",

        // Error
        "error": "#ea3c65", // red
        "error.background": "#ea3c65", // red
        "error.border": "#ea3c65", // red

        // Ghost element
        "ghost_element.active": "#333",
        "ghost_element.background": "#28282800",
        "ghost_element.disabled": "#28282800",
        "ghost_element.hover": "#282828",
        "ghost_element.selected": "#333",

        // Hidden
        "hidden": "#666",
        "hidden.background": "#222",
        "hidden.border": "#333",

        // Hint
        "hint": "#666",
        "hint.background": "#222",
        "hint.border": "#333",

        // Icon
        "icon": "#ccc",
        "icon.accent": "#ff732e", // accent
        "icon.disabled": "#666",
        "icon.muted": "#aaa",
        "icon.placeholder": "#aaa",

        // Ignored
        "ignored": "#666",
        "ignored.background": "#222",
        "ignored.border": "#333",

        // Info
        "info": "#3984f2", // blue
        "info.background": "#ccdefc", // light blue
        "info.border": "#3984f2", // blue

        // Link text
        "link_text.hover": "#ff732e", // accent

        // Minimap
        "minimap.thumb.active_background": "#333",
        "minimap.thumb.background": "#282828",
        "minimap.thumb.border": "#333",
        "minimap.thumb.hover_background": "#333",

        // Modified
        "modified": "#fedf7b", // yellow
        "modified.background": "#876c06", // dark yellow
        "modified.border": "#fedf7b", // yellow

        // Pane
        "pane.focused_border": "#333",

        // Pane group
        "pane_group.border": "#333",

        // Panel
        "panel.background": "#222",
        "panel.focused_border": "#333",
        "panel.indent_guide": "#666",
        "panel.indent_guide_active": "#aaa",
        "panel.indent_guide_hover": "#aaa",

        // Players
        "players": [
          { "background": "#333", "selection": "#333", "cursor": "#ff732e" }
        ],

        // Predictive
        "predictive": "#666",
        "predictive.background": "#222",
        "predictive.border": "#333",

        // Renamed
        "renamed": "#3984f2", // blue
        "renamed.background": "#ccdefc", // light blue
        "renamed.border": "#3984f2", // blue

        // Scrollbar
        "scrollbar.thumb.active_background": "#333",
        "scrollbar.thumb.background": "#333",
        "scrollbar.thumb.border": "#333",
        "scrollbar.thumb.hover_background": "#333",
        "scrollbar.track.background": "#222",
        "scrollbar.track.border": "#333",

        // Search
        "search.match_background": "#282828",

        // Status bar
        "status_bar.background": "#222",

        // Success
        "success": "#64d970", // green
        "success.background": "#d5f5d9", // light green
        "success.border": "#64d970", // green

        // Surface
        "surface.background": "#222",

        // Tab
        "tab.active_background": "#282828",
        "tab.inactive_background": "#222",

        // Tab bar
        "tab_bar.background": "#222",

        // Terminal
        "terminal.background": "#222",
        "terminal.foreground": "#ccc",
        "terminal.ansi.background": "#222",
        "terminal.ansi.black": "#1c1c1e",
        "terminal.ansi.red": "#ff4245",
        "terminal.ansi.green": "#30d158",
        "terminal.ansi.yellow": "#ffd600",
        "terminal.ansi.blue": "#0091ff",
        "terminal.ansi.magenta": "#db34f2",
        "terminal.ansi.cyan": "#3cd3fe",
        "terminal.ansi.white": "#f2f2f7",
        "terminal.bright_foreground": "#ccc",
        "terminal.ansi.bright_black": "#000",
        "terminal.ansi.bright_red": "#f00",
        "terminal.ansi.bright_green": "#0f0",
        "terminal.ansi.bright_yellow": "#ff0",
        "terminal.ansi.bright_blue": "#00f",
        "terminal.ansi.bright_magenta": "#f0f",
        "terminal.ansi.bright_cyan": "#0ff",
        "terminal.ansi.bright_white": "#fff",
        "terminal.dim_foreground": "#ccc",
        "terminal.ansi.dim_black": "#1c1c1e",
        "terminal.ansi.dim_red": "#ff4245",
        "terminal.ansi.dim_green": "#30d158",
        "terminal.ansi.dim_yellow": "#ffd600",
        "terminal.ansi.dim_blue": "#0091ff",
        "terminal.ansi.dim_magenta": "#db34f2",
        "terminal.ansi.dim_cyan": "#3cd3fe",
        "terminal.ansi.dim_white": "#f2f2f7",

        // Text
        "text": "#ccc",
        "text.accent": "#ff732e", // accent
        "text.disabled": "#666",
        "text.muted": "#aaa",
        "text.placeholder": "#aaa",

        // Title bar
        "title_bar.background": "#222",
        "title_bar.inactive_background": "#222",

        // Toolbar
        "toolbar.background": "#282828",

        // Unreachable
        "unreachable": "#666",
        "unreachable.background": "#222",
        "unreachable.border": "#333",

        // Version control
        "version_control.added": "#64d970", // green
        "version_control.deleted": "#ea3c65", // red
        "version_control.ignored": "#666",
        "version_control.renamed": "#3984f2", // blue
        "version_control.conflict": "#fedf7b", // yellow
        "version_control.modified": "#fedf7b", // yellow
        "version_control.conflict.divider_background": "#282828",
        "version_control.conflict.ours_background": "#d5f5d9", // light green
        "version_control.conflict.ours_marker_background": "#64d970", // green
        "version_control.conflict.theirs_background": "#fff5d8", // light yellow
        "version_control.conflict.theirs_marker_background": "#fedf7b", // yellow

        // Warning
        "warning": "#fedf7b", // yellow
        "warning.background": "#876c06", // dark yellow
        "warning.border": "#fedf7b", // yellow

        // Syntax
        "syntax": {
          // accent: #ff732e
          // red: #ff6b68
          // orange: #ff9f5b
          // green: #83d288
          // blue: #3984f2, light-blue: #99c7ff
          // purple: #bf89ff
          // grey: #666, light-grey: #aaa
          // white: #ccc
          "attribute": { "color": "#83d288" }, // green
          "boolean": { "color": "#ff732e" }, // accent
          "comment": { "color": "#666" }, // grey
          "constant": { "color": "#99c7ff" }, // light-blue
          "constructor": { "color": "#ff9f5b" }, // orange
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "enum": { "color": "#ff9f5b" }, // orange
          "function": { "color": "#bf89ff" }, // purple
          "keyword": { "color": "#ff6b68" }, // red
          "label": { "color": "#99c7ff" }, // light-blue
          "link_text": { "color": "#ff732e" }, // accent
          "link_uri": { "color": "#3984f2" }, // blue
          "number": { "color": "#ff732e" }, // accent
          "operator": { "color": "#aaa" }, // light-grey
          "preproc": { "color": "#ff6b68" }, // red
          "property": { "color": "#83d288" }, // green
          "punctuation": { "color": "#666" }, // grey
          "punctuation.bracket": { "color": "#666" }, // grey
          "punctuation.delimiter": { "color": "#666" }, // grey
          "punctuation.list_marker": { "color": "#666" }, // grey
          "string": { "color": "#ff9f5b" }, // orange
          "string.escape": { "color": "#aaa" }, // light-grey
          "tag": { "color": "#ff6b68" }, // red
          "text.literal": { "color": "#ccc" }, // white
          "title": { "font_weight": 700 }, // light-white
          "type": { "color": "#ff9f5b" }, // orange
          "variable": { "color": "#ccc" } // white
        }
      }
    }
  ]
}
