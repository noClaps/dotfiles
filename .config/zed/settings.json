{
  "features": {
    "copilot": false
  },
  "show_copilot_suggestions": false,
  "assistant": {
    "enabled": false,
    "button": false,
    "version": "1"
  },
  "tabs": {
    "git_status": true
  },
  "soft_wrap": "editor_width",
  "autosave": {
    "after_delay": {
      "milliseconds": 2000
    }
  },
  "languages": {
    "C": {
      "format_on_save": "language_server"
    },
    "C++": {
      "format_on_save": "language_server"
    }
  }
}
