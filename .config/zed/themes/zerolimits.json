{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "ZeroLimits",
  "author": "noClaps",
  "themes": [
    {
      "name": "ZeroLimits",
      "appearance": "dark",
      "style": {
        // Background
        "background": "#111",
        // Border
        "border": "#222",
        "border.variant": "#222",
        // Editor
        "editor.active_line.background": "#222",
        "editor.active_line_number": "#aaa",
        "editor.background": "#111",
        "editor.document_highlight.read_background": "#444",
        "editor.foreground": "#eee",
        "editor.gutter.background": "#111",
        "editor.invisible": "#888",
        "editor.line_number": "#444",
        // Element
        "element.hover": "#222",
        // Elevated surface
        "elevated_surface.background": "#111",
        // Ghost element
        "ghost_element.active": "#444",
        "ghost_element.hover": "#222",
        "ghost_element.selected": "#222",
        // Panel
        "panel.background": "#111",
        // Players
        "players": [
          {
            "cursor": "#aaa",
            "background": "#000",
            "selection": "#444"
          }
        ],
        // Scrollbar
        "scrollbar_thumb.background": "#222",
        "scrollbar.thumb.border": "#222",
        "scrollbar.thumb.hover_background": "#444",
        "scrollbar.track.background": "#111",
        "scrollbar.track.border": "#222",
        // Search
        "search.match_background": "#444",
        // Status bar,
        "status_bar.background": "#111",
        // Surface
        "surface.background": "#111",
        // Tab
        "tab.active_background": "#222",
        "tab.inactive_background": "#111",
        // Tab bar
        "tab_bar.background": "#111",
        // Terminal
        "terminal.ansi.bright_black": "#444",
        "terminal.background": "#111",
        // Text
        "text": "#eee",
        "text.accent": "#28f",
        "text.muted": "#aaa",
        // Title bar
        "title_bar.background": "#111",
        // Toolbar
        "toolbar.background": "#111",
        // Warning
        "warning": "#ff0",
        "warning.background": "#880",
        "warning.border": "#880",
        // Syntax
        "syntax": {
          "attribute": {
            "color": "#5ac1fe"
          },
          "boolean": {
            "color": "#d2a6ff"
          },
          "comment": {
            "color": "#abb5be8c"
          },
          "comment.doc": {
            "color": "#8c8b88"
          },
          "constant": {
            "color": "#d2a6ff"
          },
          "constructor": {
            "color": "#5ac1fe"
          },
          "embedded": {
            "color": "#bfbdb6"
          },
          "emphasis": {
            "color": "#5ac1fe"
          },
          "emphasis.strong": {
            "color": "#5ac1fe",
            "font_weight": 700
          },
          "enum": {
            "color": "#fe8f40"
          },
          "function": {
            "color": "#ffb353"
          },
          "hint": {
            "color": "#628b80",
            "font_weight": 700
          },
          "keyword": {
            "color": "#ff8f3f"
          },
          "label": {
            "color": "#5ac1fe"
          },
          "link_text": {
            "color": "#fe8f40",
            "font_style": "italic"
          },
          "link_uri": {
            "color": "#aad84c"
          },
          "number": {
            "color": "#d2a6ff"
          },
          "operator": {
            "color": "#f29668"
          },
          "predictive": {
            "color": "#5a728b",
            "font_style": "italic"
          },
          "preproc": {
            "color": "#bfbdb6"
          },
          "primary": {
            "color": "#bfbdb6"
          },
          "property": {
            "color": "#5ac1fe"
          },
          "punctuation": {
            "color": "#a6a5a0"
          },
          "punctuation.bracket": {
            "color": "#a6a5a0"
          },
          "punctuation.delimiter": {
            "color": "#a6a5a0"
          },
          "punctuation.list_marker": {
            "color": "#a6a5a0"
          },
          "punctuation.special": {
            "color": "#d2a6ff"
          },
          "string": {
            "color": "#a9d94b"
          },
          "string.escape": {
            "color": "#8c8b88"
          },
          "string.regex": {
            "color": "#95e6cb"
          },
          "string.special": {
            "color": "#e5b572"
          },
          "string.special.symbol": {
            "color": "#fe8f40"
          },
          "tag": {
            "color": "#5ac1fe"
          },
          "text.literal": {
            "color": "#fe8f40"
          },
          "title": {
            "color": "#bfbdb6",
            "font_weight": 700
          },
          "type": {
            "color": "#59c2ff"
          },
          "variable": {
            "color": "#bfbdb6"
          },
          "variant": {
            "color": "#5ac1fe"
          }
        }
      }
    }
  ]
}
