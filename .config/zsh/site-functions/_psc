#compdef psc
local context state state_descr line
_psc_commandname=$words[1]
typeset -A opt_args

_psc() {
    integer ret=1
    local -a args
    args+=(
        ':password:'
        '(-h --help)'{-h,--help}'[Show help information.]'
    )
    _arguments -w -s -S $args[@] && ret=0

    return ret
}


_custom_completion() {
    local completions=("${(@f)$($*)}")
    _describe '' completions
}

_psc
