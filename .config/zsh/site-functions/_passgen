#compdef passgen
local context state state_descr line
_passgen_commandname=$words[1]
typeset -A opt_args

_passgen() {
    integer ret=1
    local -a args
    args+=(
        ':length:'
        '-s[The separator for blocks in the password]:s:'
        '(-h --help)'{-h,--help}'[Show help information.]'
    )
    _arguments -w -s -S $args[@] && ret=0

    return ret
}


_custom_completion() {
    local completions=("${(@f)$($*)}")
    _describe '' completions
}

_passgen
